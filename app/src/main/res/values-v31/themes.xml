<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PulseApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/recovery_green</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 12+: el arranque del sistema enseña el logo sobre negro y enlaza con la animación de carga -->
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
