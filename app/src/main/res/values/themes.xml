<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PulseApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/strain_blue</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TitleLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
    </style>

    <style name="BigNumber">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">56sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
</resources>
