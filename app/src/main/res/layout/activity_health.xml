<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp">

            <TextView style="@style/LargeTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salud" />
            <TextView style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Señales medidas durante el sueño" android:textColor="@color/text_secondary" android:textSize="14sp" />

            <!-- Estado general -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_recovery_round"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_check"
                    android:tint="@color/recovery_green" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/statusTitle" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.04" android:text="--" android:textAllCaps="true" android:textColor="@color/recovery_green" android:textSize="22sp" />
                    <TextView android:id="@+id/statusSub" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Señales vitales (2 x 2, se rellena por código) -->
            <LinearLayout
                android:id="@+id/vitalsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- Pasos, calorías, VO2 máx -->
            <LinearLayout
                android:id="@+id/extrasList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical" />

            <!-- Mini monitor de estrés -->
            <LinearLayout
                android:id="@+id/stressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_elevated"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView style="@style/TitleLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Monitor de estrés" android:textSize="13sp" />
                    <TextView android:id="@+id/stressLevelText" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="" />
                    <TextView android:id="@+id/stressScoreText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="--" android:textSize="20sp" />
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
                </LinearLayout>

                <com.pulseapp.android.ui.StressChartView
                    android:id="@+id/stressChart"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <TextView
                style="@style/Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="4dp"
                android:text="La saturación de oxígeno (SpO₂) no está disponible: la pulsera solo la calcula dentro de la app oficial. La respiración es experimental." />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_tab_bar" />
</FrameLayout>
