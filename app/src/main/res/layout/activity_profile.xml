<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <include layout="@layout/include_detail_header" />

        <!-- Avatar y resumen -->
        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_elevated"
            android:contentDescription="@null"
            android:padding="20dp"
            android:src="@drawable/ic_person"
            android:tint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/ageValue" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" />
                <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Años" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/bmiValue" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" />
                <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="IMC" android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                <TextView android:id="@+id/vo2Value" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" />
                <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="VO₂ máx" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Perfil -->
        <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:text="Perfil" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout android:id="@+id/rowBirthday" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fecha de nacimiento" />
                <TextView android:id="@+id/birthdayValue" style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Añadir" android:textColor="@color/text_secondary" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/hairline" />

            <LinearLayout android:id="@+id/rowWeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Peso" />
                <TextView android:id="@+id/weightValue" style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Añadir" android:textColor="@color/text_secondary" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/hairline" />

            <LinearLayout android:id="@+id/rowHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Altura" />
                <TextView android:id="@+id/heightValue" style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Añadir" android:textColor="@color/text_secondary" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/hairline" />

            <LinearLayout android:id="@+id/rowSex" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sexo" />
                <TextView android:id="@+id/sexValue" style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Añadir" android:textColor="@color/text_secondary" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/hairline" />

            <LinearLayout android:id="@+id/rowHrMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FC máxima" />
                <TextView android:id="@+id/hrMaxValue" style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Añadir" android:textColor="@color/text_secondary" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/hairline" />

            <LinearLayout android:id="@+id/rowZoneRhr" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FC en reposo para zonas" />
                <TextView android:id="@+id/zoneRhrValue" style="@style/RowText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Automática" android:textColor="@color/text_secondary" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/profileHint"
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="" />

        <!-- Zonas -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView style="@style/TitleLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Zonas de frecuencia cardíaca" />
            <TextView android:id="@+id/hrMaxText" style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zonesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp" />

        <!-- Pulsera y datos -->
        <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Pulsera y datos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout android:id="@+id/rowAdvanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WHOOP: conexión avanzada" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" android:tint="@color/text_secondary" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:background="@color/hairline" />

            <LinearLayout android:id="@+id/rowExportData" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
                <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Exportar mis datos" android:textColor="@color/strain_blue" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:contentDescription="@null" android:src="@drawable/ic_share" android:tint="@color/strain_blue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
