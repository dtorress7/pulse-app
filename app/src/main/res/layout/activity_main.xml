<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: selector de día -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‹"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HOY"
                    android:gravity="center"
                    style="@style/TitleLabel"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Fila de 3 anillos: Recovery, Strain, Sleep -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="28dp">

                <com.pulseapp.android.ui.CircularRingView
                    android:id="@+id/recoveryRing"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1" />

                <com.pulseapp.android.ui.CircularRingView
                    android:id="@+id/strainRing"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1" />

                <com.pulseapp.android.ui.CircularRingView
                    android:id="@+id/sleepRing"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Pulso en directo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PULSO EN DIRECTO"
                    style="@style/TitleLabel" />

                <TextView
                    android:id="@+id/bpmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/BigNumber" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desconectado"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/countText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 lecturas guardadas"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
<!-- Monitor de estrés -->
            <LinearLayout
                android:id="@+id/stressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:text="MONITOR DE ESTRÉS"
                        style="@style/TitleLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:text="›"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:id="@+id/stressUpdatedText"
                        android:text="Sin datos todavía"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/stressLevelText"
                        android:text="--"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        style="@style/TitleLabel"
                        android:layout_marginEnd="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/stressScoreText"
                        android:text="--"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.pulseapp.android.ui.StressChartView
                    android:id="@+id/stressChart"
                    android:layout_width="match_parent"
                    android:layout_height="120dp" />

            </LinearLayout>

            <!-- Grid 2xN de tarjetas de estado -->
            <!-- Grid 2xN de tarjetas de estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">
                    <TextView android:text="FC REPOSO" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/minHrText" android:text="--" android:textColor="@color/text_primary" android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginStart="6dp">
                    <TextView android:text="HRV" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/hrvText" android:text="--" android:textColor="@color/recovery_green" android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">
                    <TextView android:text="FC MEDIA" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/avgHrText" android:text="--" android:textColor="@color/text_primary" android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginStart="6dp">
                    <TextView android:text="VO2MAX" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/vo2MaxText" android:text="--" android:textColor="@color/strain_blue" android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="8dp">
                <TextView android:text="FRECUENCIA RESPIRATORIA" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/respiratoryRateText" android:text="--" android:textColor="@color/sleep_blue" android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
<LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="28dp">
                <TextView android:text="CALORÍAS ESTIMADAS" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/caloriesText" android:text="--" android:textColor="@color/alert_amber" android:textSize="32sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView android:text="SLEEP PLANNER" style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/sleepNeedText"
                    android:text="--"
                    android:textColor="@color/sleep_blue"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/sleepBedtimeText"
                    android:text="Hora de dormir sugerida: --"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/sleepBreakdownText"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- Mi día: lista apilada, tappable -->
            <!-- Mi día: lista apilada, tappable -->
            <TextView
                android:text="MI DÍA"
                style="@style/TitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/rowScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="18dp">
                    <TextView android:text="Buscar dispositivos" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text="›" android:textColor="@color/text_secondary" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="18dp">
                    <TextView android:text="Sobre mí" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text="›" android:textColor="@color/text_secondary" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="18dp">
                    <TextView android:text="Ver resumen detallado" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text="›" android:textColor="@color/text_secondary" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowExport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="18dp">
                    <TextView android:text="Exportar CSV" android:textColor="@color/text_primary" android:textSize="15sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text="›" android:textColor="@color/text_secondary" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rowWhoopExperimental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="18dp">
                    <TextView android:text="Whoop avanzado (experimental)" android:textColor="@color/alert_amber" android:textSize="15sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text="›" android:textColor="@color/text_secondary" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Tab bar flotante -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_tabbar_pill"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tabHome"
            android:text="Inicio"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tabSleep"
            android:text="Sueño"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tabRecovery"
            android:text="Salud"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tabCoach"
            android:text="Coach"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="10dp"
            android:layout_marginEnd="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tabAction"
            android:text="+"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_fab_accent"
            android:layout_width="44dp"
            android:layout_height="44dp" />

    </LinearLayout>

</FrameLayout>
