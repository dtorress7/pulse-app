<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/LargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sueño" />

            <TextView
                android:id="@+id/sleepNightText"
                style="@style/RowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Rendimiento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <com.pulseapp.android.ui.CircularRingView
                    android:id="@+id/sleepPerfRing"
                    android:layout_width="150dp"
                    android:layout_height="150dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dormido" android:textSize="11sp" />
                    <TextView android:id="@+id/sleptText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textSize="26sp" />

                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Necesitabas" android:textSize="11sp" />
                    <TextView android:id="@+id/needText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/text_secondary" android:textSize="26sp" />

                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="En cama" android:textSize="11sp" />
                    <TextView android:id="@+id/inBedText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="--" android:textColor="@color/text_secondary" android:textSize="26sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fases -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fases del sueño" android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/stageBar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot_awake" />
                        <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Despierto" android:textSize="14sp" />
                        <TextView android:id="@+id/stageAwakeText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="–" android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot_light" />
                        <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Ligero" android:textSize="14sp" />
                        <TextView android:id="@+id/stageLightText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot_rem" />
                        <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="REM" android:textSize="14sp" />
                        <TextView android:id="@+id/stageRemText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="–" android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot_deep" />
                        <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Profundo" android:textSize="14sp" />
                        <TextView android:id="@+id/stageDeepText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="–" android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/stagesNote"
                    style="@style/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="" />
            </LinearLayout>

            <!-- Necesidad de sueño -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="Necesidad de sueño" android:textSize="13sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Base" />
                    <TextView android:id="@+id/needBaseText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Por el esfuerzo de hoy" />
                    <TextView android:id="@+id/needStrainText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/strain_blue" android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Deuda acumulada" />
                    <TextView android:id="@+id/needDebtText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/alert_amber" android:textSize="18sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp">
                    <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Siestas" />
                    <TextView android:id="@+id/needNapText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/text_secondary" android:textSize="18sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="@color/hairline" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
                    <TextView style="@style/RowText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/archivo_semibold" android:text="Total esta noche" />
                    <TextView android:id="@+id/needTotalText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Planificador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_elevated"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Planificador" android:textSize="13sp" />
                <TextView style="@style/Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Acuéstate entre" android:textSize="13sp" />
                <TextView android:id="@+id/bedWindowText" style="@style/BigNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="--" android:textSize="40sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_moon" android:tint="@color/sleep_blue" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                            <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Acostarse" android:textSize="10sp" />
                            <TextView android:id="@+id/bedTimeText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="--" android:textSize="22sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_button_secondary" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_sun" android:tint="@color/alert_amber" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                            <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Despertar" android:textSize="10sp" />
                            <TextView android:id="@+id/wakeTimeText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="07:30" android:textSize="22sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/plannerNote" style="@style/Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textSize="13sp" />
            </LinearLayout>

            <!-- Consistencia y eficiencia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/consistencyCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consistencia" />
                    <TextView android:id="@+id/consistencyText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="--" />
                </LinearLayout>

                <LinearLayout android:id="@+id/efficiencyCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eficiencia" />
                    <TextView android:id="@+id/efficiencyText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="--" />
                </LinearLayout>
            </LinearLayout>

            <!-- Puntuación, deuda y estrés nocturno -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Puntuación" android:textSize="10sp" />
                    <TextView android:id="@+id/sleepScoreText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="--" android:textColor="@color/sleep_blue" android:textSize="24sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deuda" android:textSize="10sp" />
                    <TextView android:id="@+id/sleepDebtText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="--" android:textColor="@color/alert_amber" android:textSize="24sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estrés noche" android:textSize="10sp" />
                    <TextView android:id="@+id/sleepStressText" style="@style/StatNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="--" android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Últimas noches -->
            <TextView style="@style/TitleLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" android:text="Últimas noches" />

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_tab_bar" />
</FrameLayout>
